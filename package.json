{
  "name": "backtrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:dag": "tsx scripts/validate-dag.ts",
    "fetch:transcripts": "tsx scripts/fetch-transcripts.ts",
    "build:index": "tsx scripts/build-index.ts",
    "query": "tsx scripts/query.ts",
    "test": "vitest run",
    "diagnose": "tsx scripts/diagnose.ts",
    "crash-course": "tsx --env-file-if-exists=.env.local scripts/crash-course.ts",
    "dev": "next dev",
